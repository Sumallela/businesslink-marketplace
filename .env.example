# Copy this file to .env and fill in your own passwords. Never commit .env.
# The database runs in Docker on your own machine (localhost only).

DB_HOST=localhost
DB_PORT=3306
DB_NAME=businesslink

# MySQL root account: only used by Docker to create the database. Do not use it day to day.
MYSQL_ROOT_PASSWORD=change-me-admin

# Read-write account used by the ETL
ETL_USER=etl_user
ETL_PASSWORD=change-me-etl

# Read-only account used by the Streamlit viewer
VIEWER_USER=viewer_user
VIEWER_PASSWORD=change-me-viewer
