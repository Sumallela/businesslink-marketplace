# Only needed when running the app OUTSIDE Docker (or on Streamlit Community Cloud).
# Copy to .streamlit/secrets.toml (git-ignored) and fill in. Use the READ-ONLY viewer account.
# For MySQL 8.4 (default port for local Docker):
[db]
host = "localhost"
port = "3306"
dbname = "businesslink"
user = "viewer_user"
password = "..."
